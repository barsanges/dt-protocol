{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "state.schema.json",
    "title": "DungeonTwisterState",
    "description": "Etat d'une partie de Dungeon Twister, vu par un arbitre omniscient",
    "type": "object",
    "properties":
    {
        "salles":
        {
            "description": "Les salles du labyrinthe",
            "type": "object",
            "additionalProperties":
            {
                "type": "object",
                "properties":
                {
                    "référence":
                    {
                        "$ref": "referencing/rooms.schema.json"
                    },
                    "position":
                    {
                        "$ref": "position/room_position.schema.json"
                    },
                    "la salle est cachée":
                    {
                        "type": "object",
                        "properties":
                        {
                            "la référence est connue de":
                            {
                                "type": "array",
                                "uniqueItems": true,
                                "items":
                                {
                                    "$ref": "referencing/players.schema.json"
                                }
                            },
                            "l'orientation est connue de":
                            {
                                "type": "array",
                                "uniqueItems": true,
                                "items":
                                {
                                    "$ref": "referencing/players.schema.json"
                                }
                            }
                        },
                        "required":
                        [
                            "la référence est connue de",
                            "l'orientation est connue de"
                        ]
                    }
                },
                "required": ["référence", "position"]
            }
        },
        "personnages":
        {
            "description": "Les personnage présents dans le labyrinthe",
            "type": "array",
            "items":
            {
                "type": "object",
                "properties":
                {
                    "couleur":
                    {
                        "$ref": "referencing/players.schema.json"
                    },
                    "nature":
                    {
                        "$ref": "referencing/characters.schema.json"
                    },
                    "emplacement":
                    {
                        "$ref": "position/cell_position.schema.json"
                    },
                    "blessé":
                    {
                        "type": "boolean"
                    }
                },
                "required":
                [
                    "couleur",
                    "nature",
                    "emplacement",
                    "blessé"
                ]
            }
        },
        "objets":
        {
            "description": "Les objets présents dans le labyrinthe",
            "type": "array",
            "items":
            {
                "type": "object",
                "properties":
                {
                    "appartenance":
                    {
                        "$ref": "referencing/memberships.schema.json"
                    },
                    "nature":
                    {
                        "$ref": "referencing/objects.schema.json"
                    },
                    "emplacement":
                    {
                        "$ref": "position/cell_position.schema.json"
                    }
                },
                "required":
                [
                    "couleur",
                    "nature",
                    "emplacement"
                ]
            }
        },
        "cartes bleues":
        {
            "description": "Les cartes du joueur bleu (main et défausse)",
            "$ref": "cards/deck.schema.json"
        },
        "cartes jaunes":
        {
            "description": "Les cartes du joueur jaune (main et défausse)",
            "$ref": "cards/deck.schema.json"
        },
        "déroulé":
        {
            "description": "Les informations générales et communes sur le déroulé de la partie",
            "type": "object",
            "properties":
            {
                "scénario":
                {
                    "$ref": "referencing/scenarios.schema.json"
                },
                "joueur résolvant":
                {
                    "description": "Le joueur qui doit résoudre un effet, même s'il ne s'agit pas nécessairement du joueur actif (e.g. le joueur qui se défend dans un combat)",
                    "oneOf":
                    [
                        {
                            "$ref": "referencing/players.schema.json"
                        },
                        {
                            "enum": [["bleu", "jaune"],
                                     ["jaune", "bleu"]]
                        }
                    ]
                },
                "joueur actif":
                {
                    "description": "Le joueur dont c'est le tour",
                    "$ref": "referencing/players.schema.json"
                },
                "premier joueur":
                {
                    "description": "Le joueur qui a joué une carte action le premier",
                    "$ref": "referencing/players.schema.json"
                },
                "tour":
                {
                    "type": "integer"
                },
                "actions restantes":
                {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required":
            [
                "scénario",
                "joueur résolvant"
            ]
        }
    },
    "required":
    [
        "salles",
        "personnages",
        "objets",
        "cartes bleues",
        "cartes jaunes",
        "déroulé"
    ]
}
