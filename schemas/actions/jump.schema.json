{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "jump.schema.json",
    "title": "DungeonTwisterJump",
    "description": "L'action de sauter",
    "type": "object",
    "properties":
    {
        "type de transition":
        {
            "const": "saut"
        },
        "joueur courant":
        {
            "$ref": "../referencing/players.schema.json"
        },
        "agent":
        {
            "$ref": "agent.schema.json"
        },
        "emport":
        {
            "oneOf":
            [
                {
                    "$ref": "../referencing/objects.schema.json"
                },
                {
                    "$ref": "../referencing/characters.schema.json"
                },
                {
                    "type": "array",
                    "items":
                    {
                        "anyOf":
                        [
                            {
                                "$ref": "../referencing/objects.schema.json"
                            },
                            {
                                "$ref": "../referencing/characters.schema.json"
                            }
                        ]
                    },
                    "minItems": 2,
                    "maxItems": 2
                }
            ]
        },
        "emplacement d'arrivée":
        {
            "$ref": "../position/cell_position.schema.json"
        }
    },
    "required":
    [
        "type de transition",
        "joueur courant",
        "agent",
        "emplacement d'arrivée"
    ]
}
