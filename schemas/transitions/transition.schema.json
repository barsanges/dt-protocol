{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "transitions/transition.schema.json",
    "title": "DungeonTwisterTransition",
    "description": "Une transition pour passer d'un état de la partie à un autre",
    "allOf":
    [
        {
            "type": "object",
            "required": ["type de transition"]
        },
        {
            "anyOf":
            [
                {
                    "$ref": "jump.schema.json"
                },
                {
                    "$ref": "rotate.schema.json"
                }
            ]
        }
    ]
}
