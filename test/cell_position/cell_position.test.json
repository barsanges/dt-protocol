{
    "target": "../../schemas/cell_position.schema.json",
    "tests":
    [
        {
            "description": "a position is a string and a pair of integers",
            "valid": true,
            "data":
            {
                "salle": "foobar",
                "coordonnées": [0, 0]
            }
        },
        {
            "description": "there is no restriction on the string itself",
            "valid": true,
            "data":
            {
                "salle": "île cœur capharnaüm",
                "coordonnées": [3, 2]
            }
        },
        {
            "description": "negative coordinates are allowed",
            "valid": true,
            "data":
            {
                "salle": "foobar",
                "coordonnées": [-1, 4]
            }
        },
        {
            "description": "the room is identified by its ID, not its reference",
            "valid": false,
            "data":
            {
                "salle": [18, "horaire"],
                "coordonnées": [2, 4]
            }
        },
        {
            "description": "the coordinates are 2D",
            "valid": false,
            "data":
            {
                "salle": "ffobar",
                "coordonnées": [1]
            }
        },
        {
            "description": "the coordinates are 2D",
            "valid": false,
            "data":
            {
                "salle": "foobar",
                "coordonnées": [1, 2, 3]
            }
        },
        {
            "description": "coordinates should be integers",
            "valid": false,
            "data":
            {
                "salle": "foobar",
                "coordonnées": [1.5, 0.9]
            }
        },
        {
            "description": "unknown fields are ignored",
            "valid": true,
            "data":
            {
                "salle": "foobar",
                "coordonnées": [4, 4],
                "autre champ": null
            }
        },
        {
            "description": "the field salle is required",
            "valid": false,
            "data":
            {
                "coordonnées": [4, 4]
            }
        },
        {
            "description": "the field coordonnées is required",
            "valid": false,
            "data":
            {
                "coordonnées": [4, 4]
            }
        },
        {
            "description": "the field coordonnées cannot be empty",
            "valid": false,
            "data":
            {
                "salle": "foobar",
                "coordonnées": []
            }
        },
        {
            "description": "the empty object is not valid",
            "valid": false,
            "data": {}
        }
    ]
}
